# Copy to .env and adjust. Nothing here is secret by default, but .env is
# gitignored because DATABASE_AUTH_TOKEN will be once the database moves.

# Bind address. 0.0.0.0 so the phone can reach it over Tailscale.
HOST=0.0.0.0
PORT=8787

# libsql URL. Local file today; swap for libsql://… or http://… to move the
# database to another machine without touching code.
DATABASE_URL=file:./data/everything.db
# DATABASE_AUTH_TOKEN=

# Leave on. A tailnet is private, not trusted. Requests from this same machine
# are trusted without a token; everything else needs one.
AUTH_REQUIRED=true

# Cross-origin callers. Empty means same-origin only, which is correct — the
# PWA is served from this very server. A wildcard would let any web page you
# visit read your data off 127.0.0.1.
CORS_ORIGIN=

LOG_LEVEL=info

# Turn on only behind a reverse proxy (Caddy, nginx, Fly.io).
TRUST_PROXY=false
